TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_IDS=
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_DIAGNOSTICS=false
NEXT_PUBLIC_BOOKING_DOMAIN=https://pro.1booking.vn/dashboard
FLIGHT_PARSER_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# AI transport: openai (default) or 9router. Keys are isolated per provider.
AI_API_PROVIDER=openai
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=cx/gpt-5.6-luna
# 9Router SDK transport: chat_completions (default) or responses.
NINE_ROUTER_API=chat_completions
HYBRID_SEARCH_MODEL_TIMEOUT_MS=15000
# legacy (default), shadow (SDK proposes tools without executing them), or
# hybrid_search (pilot search-only SDK routing; no booking actions)
AGENT_ORCHESTRATION_MODE=legacy
# ----------------------------- 1booking credentials -----------------------------------
ONE_BOOKING_AGENT_ID=your_1booking_agent_id_here
ONE_BOOKING_USERNAME=your_1booking_username_here
ONE_BOOKING_PASSWORD=your_1booking_password_here
ONE_BOOKING_HOLD_PHONENUMBER=your_1booking_hold_phonenumber_here
ONE_BOOKING_HOLD_EMAIL=your_1booking_hold_email_here
ONE_BOOKING_HOLD_NAME=your_1booking_hold_name_here
